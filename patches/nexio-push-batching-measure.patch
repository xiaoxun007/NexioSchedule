+    // ── gh6 P0：只读体积测量（纯观测，不接发送逻辑、不改 buildFullJson 输出） ──────
+
+    /**
+     * 整包 UTF-8 字节数（只读测量）。
+     *
+     * 复用 [buildFullJson] 的完整组装逻辑，只统计 UTF-8 字节，不发送、不落盘；
+     * 供诊断面板观测整包体积，不能用于发送路径的任何决策。
+     */
+    fun measureFullBytes(
+        repository: CourseRepository,
+        context: Context,
+        scheduleId: String = "",
+    ): Int = buildFullJson(repository, context, scheduleId)
+        .toByteArray(Charsets.UTF_8).size
+
+    /**
+     * 按日期条目统计字节（只读测量）：`date` → 该日条目 JSON 的 UTF-8 字节数。
+     *
+     * 展开口径与分批编排一致（[DayScheduleResolver] 逐日裁决），仅供诊断面板观测
+     * 「日期条目数 / 最大单日期字节」；不参与发送。
+     */
+    fun bucketBytesByDate(
+        repository: CourseRepository,
+        context: Context,
+        scheduleId: String = "",
+    ): Map<String, Int> {
+        val sid = scheduleId.ifEmpty { repository.getCurrentScheduleId() }
+        val today = todayLocalDate()
+        val (windowFirst, windowLast) = holidayWindow(repository, sid, today)
+        val entriesByYear = HolidayManager.loadAllByYearFor(sid)
+        val buckets = LinkedHashMap<String, Int>()
+        var d = windowFirst
+        while (d <= windowLast) {
+            val resolution = runCatching {
+                DayScheduleResolver.resolveDaySchedule(d, repository, entriesByYear)
+            }.getOrNull()
+            if (resolution != null) {
+                buckets[d.toString()] =
+                    renderMeasureDay(d, resolution).toString().toByteArray(Charsets.UTF_8).size
+            }
+            d = d.plusDays(1)
+        }
+        return buckets
+    }
+
+    /** 测量用的单日条目（结构与分批消息的日期条目同构）；只序列化算字节。 */
+    private fun renderMeasureDay(
+        date: LocalDate,
+        resolution: DayScheduleResolver.DayScheduleResolution,
+    ): JSONObject {
+        val courses = JSONArray()
+        for (course in resolution.courses) {
+            courses.put(
+                JSONObject()
+                    .put("id", course.id)
+                    .put("name", course.name)
+                    .put("location", course.classroom ?: "")
+                    .put("teacher", course.teacher ?: "")
+            )
+        }
+        return JSONObject()
+            .put("date", date.toString())
+            .put("week", resolution.displayWeek)
+            .put("isHoliday", resolution.isHolidayDate)
+            .put("isWorkSwap", resolution.isWorkSwap)
+            .put("courses", courses)
+    }
+
