+/**
+ * 手环互联权限引导（fork 定制）：优先拉起小米运动健康/穿戴让用户检查配对与互联；
+ * 未安装配套 App 时退回本应用系统设置页。找不到可跳转页面时静默降级，不崩溃。
+ */
+private fun openWearPermissionSettings(context: Context) {
+    val companion = listOf("com.mi.health", "com.xiaomi.wearable")
+        .firstNotNullOfOrNull {
+            runCatching { context.packageManager.getLaunchIntentForPackage(it) }.getOrNull()
+        }
+    val intent = companion ?: Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
+        data = Uri.fromParts("package", context.packageName, null)
+    }
+    if (context !is Activity) intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+    runCatching { context.startActivity(intent) }
+        .onFailure { showToast("无法打开授权页面，请手动到 设置→应用 中检查本应用权限") }
+}
