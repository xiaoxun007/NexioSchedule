+    /** gh3 P13：排一次退避重试；ACK 到达会由 [cancelPendingRetry] 取消。 */
+    private fun scheduleRetry(reason: String, scheduleName: String, detail: String) {
+        retryCount += 1
+        pendingRetryReason = reason
+        pendingRetryScheduleName = scheduleName
+        sendState = "RETRY"
+        sendError = "发送失败，第 ${retryCount}/${MAX_RETRY} 次重试：$detail"
+        cancelAckTimeout()
+        releasePushSlot()
+        val delay = RETRY_DELAY_MS[(retryCount - 1).coerceAtMost(RETRY_DELAY_MS.size - 1)]
+        val exec = scheduler ?: Executors.newSingleThreadScheduledExecutor().also { scheduler = it }
+        cancelPendingRetry()
+        retryFuture = exec.schedule({
+            NexioLog.i(TAG, "push retry ${retryCount}/${MAX_RETRY}, reason=$reason")
+            ensurePermissionThenPush(pendingRetryReason, pendingRetryScheduleName)
+        }, delay, TimeUnit.MILLISECONDS)
+    }
+
+    private fun cancelPendingRetry() {
+        retryFuture?.cancel(false)
+        retryFuture = null
+        pendingRetryReason = ""
+        pendingRetryScheduleName = ""
+    }
