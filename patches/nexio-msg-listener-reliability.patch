+    /**
+     * gh3 P15：镜像手环 parseMessage 的 `data` 解包规则，消除手机/手表两侧解析不对称：
+     *  - 外层对象且无 `protocol` 时，`data` 为字符串 → 再解析一层；
+     *  - `data` 为对象 → 把 `data` 的键合并到外层（等价手表侧 Object.assign）。
+     * 解析失败返回 null，异常写入 [lastInboundError] 供诊断面板可见。
+     */
+    private fun unwrapIncoming(text: String): JSONObject? {
+        return try {
+            val outer = JSONObject(text)
+            if (!outer.has("protocol") && outer.has("data")) {
+                val dataAny = outer.get("data")
+                when (dataAny) {
+                    is String -> JSONObject(dataAny)
+                    is JSONObject -> {
+                        val merged = JSONObject()
+                        val keys = outer.keys()
+                        while (keys.hasNext()) {
+                            val k = keys.next()
+                            if (k != "data") merged.put(k, outer.get(k))
+                        }
+                        val dKeys = dataAny.keys()
+                        while (dKeys.hasNext()) {
+                            val k = dKeys.next()
+                            merged.put(k, dataAny.get(k))
+                        }
+                        merged
+                    }
+                    else -> outer
+                }
+            } else {
+                outer
+            }
+        } catch (e: Exception) {
+            lastInboundError = e.message ?: "入站消息解析失败"
+            NexioLog.w(TAG, "unwrap inbound fail: ${e.message}")
+            null
+        }
+    }
