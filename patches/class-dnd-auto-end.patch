- 新增存储项 class_dnd_auto_end，默认 false
- 自动开启勿扰/静音保持不变
- 开启「下课自动关闭」时注册下课闹钟，到点恢复上课前状态
- 关闭（默认）时下课保持静音/勿扰，不自动恢复
- 课程提醒页新增「下课自动关闭」开关
---
 .../haooz/chedule/data/CourseRepository.kt    | 14 +++++++++
 .../haooz/chedule/reminder/ClassDndHelper.kt  | 31 ++++++++++++-------
 .../chedule/reminder/ClassDndReceiver.kt      |  9 +++---
 .../ui/activities/CourseReminderScreen.kt     | 15 ++++++++-
 .../chedule/viewmodel/SettingsViewModel.kt    | 12 +++++++
 5 files changed, 64 insertions(+), 17 deletions(-)

diff --git a/app/src/main/java/com/haooz/chedule/data/CourseRepository.kt b/app/src/main/java/com/haooz/chedule/data/CourseRepository.kt
index 8396d42..f89e207 100644
--- a/app/src/main/java/com/haooz/chedule/data/CourseRepository.kt
+++ b/app/src/main/java/com/haooz/chedule/data/CourseRepository.kt
@@ -210,6 +210,8 @@ class CourseRepository private constructor(context: Context) {
         private const val KEY_CLASS_DND = "class_dnd_enabled"
         /** 上课时启用的系统勿扰档位：0=勿扰模式 (DND, NONE)，1=静音模式 (SILENT, PRIORITY，闹钟仍响) */
         private const val KEY_CLASS_DND_MODE = "class_dnd_mode"
+        /** 下课是否自动恢复上课前的响铃/勿扰状态；默认 false（不自动关闭，保持当前系统状态） */
+        private const val KEY_CLASS_DND_AUTO_END = "class_dnd_auto_end"
         private const val KEY_SHIFT_MODE = "shift_mode_enabled"
         private const val KEY_SHIFT_SELECTED_SCHEDULES = "shift_selected_schedules"
         private const val KEY_DEFAULT_HOMEPAGE = "default_homepage"
@@ -1065,6 +1067,18 @@ class CourseRepository private constructor(context: Context) {
         prefs.edit { putInt(KEY_CLASS_DND_MODE, mode) }
     }
 
+    /**
+     * 「下课自动关闭」：开启后下课时自动恢复上课前的响铃/勿扰状态；
+     * 关闭（默认）则下课保持当前系统状态，需用户手动调整。
+     */
+    fun getClassDndAutoEnd(): Boolean {
+        return prefs.getBoolean(KEY_CLASS_DND_AUTO_END, false)
+    }
+
+    fun setClassDndAutoEnd(enabled: Boolean) {
+        prefs.edit { putBoolean(KEY_CLASS_DND_AUTO_END, enabled) }
+    }
+
     /**
      * 占用判断为分钟级时间重叠；自定义时间课按实际起止参与，时间无法确定时回退节次重叠。
      *
diff --git a/app/src/main/java/com/haooz/chedule/reminder/ClassDndHelper.kt b/app/src/main/java/com/haooz/chedule/reminder/ClassDndHelper.kt
index ac2e003..6f34f35 100644
--- a/app/src/main/java/com/haooz/chedule/reminder/ClassDndHelper.kt
+++ b/app/src/main/java/com/haooz/chedule/reminder/ClassDndHelper.kt
@@ -1,5 +1,5 @@
 // 0=DND(需勿扰权限) 1=SILENT(仅关铃声振动) 2=PRIORITY(需勿扰权限)。
-// 下课/关开关时恢复开启前快照，不覆盖用户手动改过的设置。
+// 上课自动开启静音/勿扰；是否在下课自动恢复由用户开关 getClassDndAutoEnd 决定（默认 false，不自动关闭，保持当前系统状态）。
 package com.haooz.chedule.reminder
 
 import android.app.AlarmManager
@@ -26,7 +26,7 @@ object ClassDndHelper {
     private const val KEY_ORIGINAL_RINGER = "dnd_original_ringer_mode"
     private const val KEY_ORIGINAL_FILTER = "dnd_original_interruption_filter"
 
-    // 与课程提醒闹钟的 10000 段错开
+    // 与课程提醒闹钟的 10000 段错开；END 段仅在「下课自动关闭」开启时用于注册下课闹钟
     private const val RC_DND_START_BASE = 30000
     private const val RC_DND_END_BASE = 40000
 
@@ -206,20 +206,23 @@ object ClassDndHelper {
         return false
     }
 
-    // 闹钟/每分钟刷新/通知按钮共同调用，幂等
+    // 闹钟/每分钟刷新/通知按钮共同调用，幂等。
+    // 课堂内自动开启静音/勿扰（不受 autoEnd 影响）；下课/功能关闭/无权限时，
+    // 仅当「下课自动关闭」开启才恢复，否则保持当前系统状态。
     fun applyCurrentState(context: Context) {
+        val autoEnd = CourseRepository(context).getClassDndAutoEnd()
         if (!isFeatureAvailable(context)) {
-            restoreDndIfApplied(context)
+            if (autoEnd) restoreDndIfApplied(context)
             return
         }
         if (!isInClass(context)) {
-            restoreDndIfApplied(context)
+            if (autoEnd) restoreDndIfApplied(context)
             return
         }
         val mode = currentMode(context)
         if ((mode == MODE_DND || mode == MODE_PRIORITY) && !isDndPermissionGranted(context)) {
             // 没权限时不强行开启，也不静默切到 SILENT
-            restoreDndIfApplied(context)
+            if (autoEnd) restoreDndIfApplied(context)
             return
         }
         enableDndByApp(context)
@@ -297,12 +300,16 @@ object ClassDndHelper {
                 action = ClassDndReceiver.ACTION_CLASS_START,
                 triggerAt = startMillis
             )
-            scheduleOne(
-                context, alarmManager,
-                requestCode = RC_DND_END_BASE + course.id.hashCode(),
-                action = ClassDndReceiver.ACTION_CLASS_END,
-                triggerAt = endMillis
-            )
+            // 仅当开启「下课自动关闭」时才注册下课闹钟：下课后自动恢复上课前的铃声/勿扰状态；
+            // 关闭该选项时只自动开启、不自动关闭，保持静音/勿扰直到用户手动恢复
+            if (repository.getClassDndAutoEnd()) {
+                scheduleOne(
+                    context, alarmManager,
+                    requestCode = RC_DND_END_BASE + course.id.hashCode(),
+                    action = ClassDndReceiver.ACTION_CLASS_END,
+                    triggerAt = endMillis
+                )
+            }
         }
     }
 
diff --git a/app/src/main/java/com/haooz/chedule/reminder/ClassDndReceiver.kt b/app/src/main/java/com/haooz/chedule/reminder/ClassDndReceiver.kt
