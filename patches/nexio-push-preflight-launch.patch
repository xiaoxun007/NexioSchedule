+    /** gh3 P14：推送前主动拉起（失败不阻断发送），之后留 [LAUNCH_READY_WAIT_SEC] 就绪窗口。 */
+    private fun preflightLaunch(id: String) {
+        try {
+            if (!permissionGranted.get()) {
+                lastLaunchState = "跳过：权限未授予"
+                return
+            }
+            if (peerInstalled == false) {
+                lastLaunchState = "跳过：对端应用未安装"
+                return
+            }
+            val api = nodeApi ?: run {
+                lastLaunchState = "跳过：节点 API 不可用"
+                return
+            }
+            launchWearAppForNode(api, id, "preflight")
+            Thread.sleep((LAUNCH_READY_WAIT_SEC * 1000).toLong())
+        } catch (e: Exception) {
+            lastLaunchState = "拉起异常：${e.message ?: ""}"
